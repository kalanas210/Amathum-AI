[Unit]
Description=Naxter Automations (Next.js workflow builder)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=horapusa
WorkingDirectory=/home/horapusa/ryzera/automation/web
Environment=NODE_ENV=production
# Bound to the Tailscale IP so the (unauthenticated) app is only reachable over
# Tailscale. Change -H to 0.0.0.0 to listen on all interfaces, or to 127.0.0.1
# to keep it local and front it with nginx. Restart handles the case where the
# Tailscale interface isn't up yet at boot.
ExecStart=/usr/bin/node /home/horapusa/ryzera/automation/web/node_modules/next/dist/bin/next start -p 5056 -H 100.68.210.114
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
