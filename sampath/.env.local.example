# Copy to .env.local and fill in. NEVER commit the filled-in file.

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Port for the WebSocket relay that bridges the browser to Gemini Live
WS_PORT=3002

# Optional — Cloudflare Turnstile gate on the demo page.
# Leave blank to disable the bot check in local development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
